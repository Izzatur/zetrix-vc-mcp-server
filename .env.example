# -----------------------------------------------------------------------------
# Zetrix VC MCP Server — environment configuration
# -----------------------------------------------------------------------------

# Target network for the Zetrix BaaS VC/VP API:
#   uat  -> https://api-sandbox.zetrix.com
#   prod -> https://api.zetrix.com
ZETRIX_VC_NETWORK=uat

# Optional explicit base URL override (takes precedence over ZETRIX_VC_NETWORK).
# ZETRIX_VC_BASE_URL=https://api-sandbox.zetrix.com

# Transport mode: "stdio" (default, for MCP clients) or "http" (Streamable HTTP)
# ZETRIX_VC_TRANSPORT=stdio
# ZETRIX_VC_PORT=3000

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------

# AWS API Gateway key — sent as `x-api-key` on every request.
AWS_GATEWAY_API_KEY=

# Zetrix BaaS API key / bearer token — sent as `Authorization: Bearer <key>`.
BAAS_API_KEY=

# -----------------------------------------------------------------------------
# Issuer identity (used by zetrix_vc_issue)
# -----------------------------------------------------------------------------

# Issuer public key / identifier (optional — used for logging / metadata).
ISSUER_KEY=

# Issuer Ed25519 private key (56 chars) used to sign issued VCs.
ISSUER_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Holder identity (used by zetrix_vc_apply / zetrix_vc_download / zetrix_vp_*)
# -----------------------------------------------------------------------------

# Holder Ed25519 public key. If omitted, it is derived from HOLDER_PRIVATE_KEY.
HOLDER_KEY=

# Holder Ed25519 private key (56 chars) used to sign VC applications, download
# requests and VP blobs.
HOLDER_PRIVATE_KEY=

# Holder DID/ZID — e.g. did:zid:ztx...  Used by zetrix_vc_issue and
# zetrix_vc_request_credential as the holder the VC is issued to.
HOLDER_DID=

# -----------------------------------------------------------------------------
# Defaults
# -----------------------------------------------------------------------------

# Fallback VC template ID applied when a caller omits `templateId` on an item
# in the `data[]` array of zetrix_vc_apply / zetrix_vc_issue. If the caller
# specifies one explicitly, theirs wins.
DEFAULT_TEMPLATE_ID=

# -----------------------------------------------------------------------------
# On-chain contract addresses
# -----------------------------------------------------------------------------

# Template Data Store (TDS) contract — queried by zetrix_vc_get_template_detail
# to resolve a template record via:
#   GET <NODE>/getAccountMetaData?address=<TDS_CONTRACT_ADDRESS>&key=template__<TEMPLATE_ID>
TDS_CONTRACT_ADDRESS=

# Revocation Contract List (RCL) address — used for revocation lookups.
RCL_CONTRACT_ADDRESS=

# -----------------------------------------------------------------------------
# Zetrix node RPC (separate from the BaaS API)
# -----------------------------------------------------------------------------
# uat  -> https://test-node.zetrix.com
# prod -> https://node.zetrix.com
# Derived from ZETRIX_VC_NETWORK. Set only when pointing at a custom node.
# ZETRIX_NODE_BASE_URL=
