# Copy this file to `.env` before starting the workspace MCP server in VS Code.
# Only secrets belong here; the checked-in `.vscode/mcp.json` provides the public
# UAT defaults for network, template, and contract addresses.

AWS_GATEWAY_API_KEY=
BAAS_API_KEY=
ISSUER_PRIVATE_KEY=
HOLDER_PRIVATE_KEY=

# Optional overrides:
# ISSUER_DID=
# HOLDER_DID=
# ZETRIX_VC_DOWNLOAD_DIR=
# ZETRIX_VC_BASE_URL=
# ZETRIX_NODE_BASE_URL=
# ZETRIX_ZID_RESOLVER_URL=
